# docker-compose와 서버가 함께 읽는 값. 복사해서 .env로 저장한다 (.env는 커밋하지 않는다).
# 아래 값은 로컬 개발용 기본값이다. 외부에 노출되는 환경에서는 반드시 바꾼다.
# 여기에는 호스트 쪽 값(포트, 토큰, 키, DB 계정)만 둔다. 컨테이너 사이 주소(postgres, fake-provider, host.docker.internal)는
# docker-compose.yml에 고정되어 있고, 서버를 bootRun으로 직접 띄울 때는 같은 변수를 셸 환경 변수로 준다.

# PostgreSQL (compose의 postgres 서비스와 서버의 연결 설정에 함께 쓰임)
POSTGRES_DB=tollgate
POSTGRES_USER=tollgate
POSTGRES_PASSWORD=tollgate
# 호스트에 노출할 PostgreSQL 포트. bootRun으로 개발할 때 서버가 여기로 붙는다
POSTGRES_PORT=5432

# 서버가 PostgreSQL에 접속할 주소. 호스트에서 서버를 직접 띄우면 localhost, compose 안에서는 postgres
TOLLGATE_DB_HOST=localhost
TOLLGATE_DB_PORT=5432

# 호스트에 노출할 서버·대시보드 포트. 컨테이너 안에서는 각각 8080·80으로 고정된다
SERVER_PORT=8080
DASHBOARD_PORT=3000

# 관리자 API(/admin/**)와 대시보드 로그인에 쓰는 토큰. 16자 이상, 반드시 바꿀 것 (예: openssl rand -hex 24)
TOLLGATE_ADMIN_TOKEN=change-me-to-a-long-random-token

# 시작 시 가져올 요금표 YAML(선택). 서버를 실행한 작업 디렉터리 기준 상대 경로 또는 절대 경로.
# 파일에 있고 DB에 없는 (provider, model, effective_from) 행만 추가한다. 비우면 가져오지 않는다.
TOLLGATE_PRICES_FILE=config/prices.example.yaml

# 가짜 공급처(fake-provider). 모델명 지시가 없을 때의 기본값이며, 지시가 있으면 지시가 우선한다 (README "가짜 공급처" 참고).
# 호스트에 노출할 가짜 공급처 포트. 컨테이너 안에서는 9090으로 고정된다
FAKE_PROVIDER_PORT=9090
FAKE_INPUT_TOKENS=100
FAKE_CACHED_INPUT_TOKENS=0
FAKE_OUTPUT_TOKENS=50
FAKE_TTFT_MS=0
FAKE_CHUNK_INTERVAL_MS=0
# 0~1. 지시와 무관하게 이 확률로 500을 돌려준다.
FAKE_ERROR_RATE=0
# 비우면 인증을 검사하지 않는다. 값을 주면 Authorization: Bearer 또는 x-api-key로 같은 값을 보내야 하며, 서버도 같은 변수의 값을 가짜 공급처 키로 보낸다.
FAKE_API_KEY=

# 공급처 연결. 키 값이 비어 있으면 그 공급처는 비활성으로 뜨고, 가짜 공급처와 Ollama는 키 없이 동작한다.
# 가짜 공급처 주소. 호스트에서 직접 띄우면 localhost, compose 안에서는 fake-provider
FAKE_PROVIDER_URL=http://localhost:9090
# 로컬 Ollama의 OpenAI 호환 주소. 설정에서 기본 공급처라 패턴에 안 맞는 모델이 여기로 간다
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI 키(선택). 비워 두면 gpt-* 요청은 503 provider_disabled로 거절된다
OPENAI_API_KEY=
# Anthropic 키(선택). 비워 두면 Anthropic 형식 요청 중 가짜 공급처로 가지 않는 것은 503 provider_disabled로 거절된다
ANTHROPIC_API_KEY=
# 엑사원(EXAONE API Platform) 키(선택). 비워 두면 k-exaone* 요청은 503 provider_disabled로 거절된다.
# 키는 발급 후 30일 뒤 만료되므로 다시 발급해 바꾼다. 약관상 비상업적 용도로 본인만 쓴다(README "엑사원 쓰기" 참고)
EXAONE_API_KEY=
