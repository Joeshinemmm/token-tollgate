# docker-compose와 서버가 함께 읽는 값. 복사해서 .env로 저장한다 (.env는 커밋하지 않는다).
# 아래 값은 로컬 개발용 기본값이다. 외부에 노출되는 환경에서는 반드시 바꾼다.

# PostgreSQL (compose의 postgres 서비스와 서버의 연결 설정에 함께 쓰임)
POSTGRES_DB=tollgate
POSTGRES_USER=tollgate
POSTGRES_PASSWORD=tollgate
# 호스트에 노출할 PostgreSQL 포트
POSTGRES_PORT=5432

# 서버가 PostgreSQL에 접속할 주소. 호스트에서 서버를 직접 띄우면 localhost, compose 안에서는 postgres
TOLLGATE_DB_HOST=localhost
TOLLGATE_DB_PORT=5432

# 서버 포트
SERVER_PORT=8080

# 관리자 API(/admin/**)와 대시보드 로그인에 쓰는 토큰. 16자 이상, 반드시 바꿀 것 (예: openssl rand -hex 24)
TOLLGATE_ADMIN_TOKEN=change-me-to-a-long-random-token

# 시작 시 가져올 요금표 YAML(선택). 서버를 실행한 작업 디렉터리 기준 상대 경로 또는 절대 경로.
# 파일에 있고 DB에 없는 (provider, model, effective_from) 행만 추가한다. 비우면 가져오지 않는다.
TOLLGATE_PRICES_FILE=config/prices.example.yaml

# 가짜 공급처(fake-provider). 모델명 지시가 없을 때의 기본값이며, 지시가 있으면 지시가 우선한다 (README "가짜 공급처" 참고).
FAKE_PROVIDER_PORT=9090
FAKE_INPUT_TOKENS=100
FAKE_CACHED_INPUT_TOKENS=0
FAKE_OUTPUT_TOKENS=50
FAKE_TTFT_MS=0
FAKE_CHUNK_INTERVAL_MS=0
# 0~1. 지시와 무관하게 이 확률로 500을 돌려준다.
FAKE_ERROR_RATE=0
# 비우면 인증을 검사하지 않는다. 값을 주면 Authorization: Bearer 또는 x-api-key로 같은 값을 보내야 한다.
FAKE_API_KEY=
